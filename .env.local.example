# Anthropic — general Q&A and non-SDK custom UI fallback
ANTHROPIC_API_KEY=

# Cursor SDK — custom UI generation via /api/custom-ui
CURSOR_API_KEY=

# Route custom UI cards to Cursor SDK (requires CURSOR_API_KEY)
NEXT_PUBLIC_CUSTOM_UI_SDK=true

# Disable 3-minute Q&A timeout while testing long SDK runs
# NEXT_PUBLIC_* is required — browser Card watchdog reads this at build time
NEXT_PUBLIC_QA_TURN_TIMEOUT_ENABLED=false
QA_TURN_TIMEOUT_ENABLED=false

# FTUE coach marks — off until ready to ship (preview locally with ?onboarding=1)
NEXT_PUBLIC_ONBOARDING_TOUR_ENABLED=false

# Admin portal — comma-separated Google account emails
ADMIN_ALLOWED_EMAILS=prem.pradeep97@gmail.com,ravisalugu@gmail.com

# Required for admin Beta Suggestions inbox and Usage Analysis (server-only; never expose to client)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional: plan | agent (default agent)
# CUSTOM_UI_SDK_MODE=agent

# SDK sandbox (off by default on Windows — set true to opt in on Linux/macOS)
# CUSTOM_UI_SDK_SANDBOX=false

# Required by the Vercel cron routes (/api/cron/*). Without it those routes
# return 401 and the nightly usage snapshot silently never runs.
# Set the SAME value in Vercel → Project Settings → Environment Variables.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Guest sign-in wall. "on" enables it; anything else (or unset) disables it.
# Independent of BILLING_ENFORCEMENT: the guest wall and signed-in limits ship
# separately and must be switchable on their own.
GUEST_ENFORCEMENT=
# Salt for hashing visitor IPs (the shared-address abuse backstop). The raw IP
# is never stored. Leave blank to skip the IP check entirely.
# Generate with: openssl rand -hex 32
GUEST_IP_SALT=
